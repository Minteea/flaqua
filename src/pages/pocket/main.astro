---
import { MainBgLoader } from "./_bg/SceneThemeBgLoader.solid";
import ShapeRing from "./_components/ShapeRing.astro";
import ShapeWave from "./_components/ShapeWave.astro";
import Layout from "./_layout.astro";
import {
  TopInfo,
  BottomInfo,
  TimeLabel,
  FooterTaskInfo,
  FooterAppInfo,
  FooterMusicInfo,
  RecLabel,
} from "./_widgets/widgets.react";
---

<Layout>
  <div id="wrap">
    <div id="dynamic-bg">
      <MainBgLoader client:only="solid-js" />
    </div>
    <div id="top">
      <div id="top-live">● <RecLabel client:only /></div>
      <div id="top-info">
        <TopInfo client:only />
      </div>
      <div id="top-dots"><span>●</span> <span>●</span> <span>●</span></div>
    </div>
    <div id="center">
      <div id="main" class="box">NO SIGNAL</div>
      <div id="side" class="box">
        <div id="comments-head">
          <ShapeWave />
          <ShapeRing />
          <div id="comments-title">COMMENTS</div>
        </div>
        <div id="comments"></div>
        <div id="streamer"></div>
      </div>
    </div>
    <div id="footer">
      <div id="time"><TimeLabel client:only /></div>
      <div id="footer-info">
        <FooterTaskInfo client:only />
        <FooterAppInfo client:only />
        <FooterMusicInfo client:only />
      </div>
    </div>
    <div id="bottom">
      <div id="bottom-info">
        <BottomInfo client:only />
      </div>
    </div>
  </div>
</Layout>

<style is:global lang="scss">
  #wrap {
    padding: 15px 0;
  }

  #top {
    position: relative;
    display: flex;
    align-items: center;
    margin: 0 15px;
    height: 40px;
    font-size: 28px;
    line-height: 40px;
    gap: 15px;
  }
  #top-info {
    display: flex;
    align-items: center;
    height: 100%;
    flex-shrink: 0;
    .carousel-item {
      display: flex;
      align-items: center;
    }
  }
  #top-live {
    flex-shrink: 0;
    width: 150px;
    font-size: 32px;
    font-weight: 900;
  }
  #top-info {
    flex-grow: 1;
    i {
      margin-right: 5px;
    }
  }

  #top-dots {
    text-align: right;
    width: 320px;
    flex-shrink: 0;
  }

  #center {
    position: relative;
    display: flex;
    margin: 10px 0;
    height: 900px;
  }

  #main {
    display: flex;
    width: 1600px;
    height: 100%;
    flex-shrink: 0;
    background-color: var(--main-bg);
    justify-content: center;
    align-items: center;
    font-size: 180px;
    font-weight: 900;
    font-style: italic;
  }

  #side {
    flex-grow: 1;
    height: 100%;
    overflow: hidden;
  }

  #comments {
    flex-grow: 1;
    height: 50%;
    margin-bottom: 20px;
    &-head {
      position: relative;
      flex-grow: 1;
      height: 50px;
      padding-left: 8px;
      .shape-wave {
        height: 72px;
        left: -30px;
        position: absolute;
        top: 0;
      }
      .shape-ring {
        height: 40px;
        right: 5px;
        top: 15px;
        position: absolute;
      }
      :where(.shape-wave) {
        fill: transparent;
      }
      :where(.shape-ring) {
        fill: transparent;
      }
    }
    &-title {
      position: relative;
      font-size: 42px;
      font-weight: 900;
    }
  }

  #streamer {
    flex-grow: 1;
    height: calc(50% - 70px);
  }

  #footer {
    position: relative;
    --height: 45px;

    display: flex;
    margin: 15px 15px 5px;
    height: var(--height);
    font-size: 28px;
    font-weight: 600;
    gap: 15px;

    &-info {
      display: flex;
      gap: 30px;
      flex-grow: 1;
    }
    &-task {
      flex: 1;
    }
    &-app {
      flex: 1;
      &.is-hidden {
        flex: 0;
      }
    }
    &-music {
      flex: 4;
    }
  }
  .footer-item {
    position: relative;
    height: 100%;
    overflow: clip;
    transition: flex 0.3s ease !important;
    &-content {
      white-space: nowrap;
      > i {
        margin-right: 5px;
      }
      > span {
        height: 100%;
        line-height: var(--height);
      }
      transition: transform 0.3s ease !important;
    }
    &.is-hidden &-content {
      transform: translateY(100%);
    }
  }

  #bottom {
    position: relative;
    display: flex;
    margin: 0;
    height: 50px;
    font-size: 32px;
    font-weight: 600;
  }

  #time {
    flex-shrink: 0;
    width: 150px;
    height: 100%;
    line-height: var(--height);
    text-align: center;
    font-weight: 900;
  }

  #bottom-info {
    flex-grow: 1;
    height: 100%;
  }
  #bottom-info .marquee-item::after {
    content: "／";
    display: inline-block;
    padding: 0 10px;
  }

  .box {
    background: var(--content-bg);
  }
  #scene[data-style="shade"] .box {
    box-shadow: 8px 8px #20202014;
  }

  .carousel-content {
    position: absolute;
  }
  .carousel-content-enter {
    animation: 0.5s ease forwards carousel-enter;
  }
  .carousel-content-leave {
    animation: 0.5s ease forwards carousel-leave;
  }

  @keyframes carousel-enter {
    from {
      transform: translateY(100%);
    }
    to {
      transform: translateY(0);
    }
  }
  @keyframes carousel-leave {
    to {
      transform: translateY(-100%);
    }
  }

  #dynamic-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }
</style>
