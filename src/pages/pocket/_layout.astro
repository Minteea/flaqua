---
import BaseLayout from "../_layout.astro";
import "@tabler/icons-webfont/dist/tabler-icons.scss";
import "./_style/2025.scss";
import "./_style/2026.scss";

interface Props {
  class?: string;
}
---

<BaseLayout>
  <div id="scene" class={Astro.props.class || ""} data-scene={"0"}>
    <slot />
  </div>
</BaseLayout>

<style is:global lang="scss">
  :root {
    --font: "Gotham Pro", "Source Han Sans SC", sans-serif;
    --background: aqua;
    --foreground: black;
    --content-bg: #ffffff80;
  }
  #scene {
    position: relative;
    font-family: var(--font);
    width: 1920px;
    height: 1080px;
    background: var(--background);
    color: var(--foreground);
    * {
      transition:
        color 0.1s,
        background-color 0.5s;
    }
  }

  .textmark-time {
    padding-inline: 0.25em;
    font-weight: bold;
  }
</style>

<script>
  import { bindStore } from "@/scripts/flaquaApi";
  import { store, sceneTheme } from "./_store";
  import { PluginLunar } from "dayjs-plugin-lunar";
  import dayjs from "dayjs";
  import Duration from "dayjs/plugin/duration";

  // 添加全局依赖
  dayjs.extend(PluginLunar);
  dayjs.extend(Duration);
  (window as any).dayjs = dayjs;

  //

  bindStore(store);

  (window as any).store = store;

  const scene = document.getElementById("scene")!;

  sceneTheme.subscribe((val) => {
    scene.setAttribute("data-theme", val);
  });
</script>
