---
import Layout from "./_layout.astro";
import { store } from "./_store";
import { TopInfo, BottomInfo, TimeLabel } from "./_widgets/widgets.react";
---

<Layout>
  <div id="wrap">
    <div id="logo-area"></div>
  </div>
</Layout>

<style is:global>
  #wrap {
    width: 100%;
    height: 100%;
  }
  #logo-area {
    width: 600px;
    height: 60px;
    background: var(--logo-image);
    /* background-color: #ffffff40; */
    background-repeat: no-repeat;
  }
  #scene {
    background: transparent !important;
  }
</style>
