---
import VisualFrame from "./_components/VisualFrame.astro";
import Layout from "./_layout.astro";
import { GoodbyeInfo } from "./_widgets/widgets.react";
---

<Layout>
  <div class="special-goodbye">
    <div class="scene-background"></div>
    <div class="scene-frame">
      <VisualFrame />
    </div>
    <div class="scene-background-fore"></div>
    <div class="loading-info" style={{ width: "100%" }}>
      <GoodbyeInfo client:only />
    </div>
    <div class="scene-foreground"></div>
  </div>
</Layout>

<style is:global>
  .special-goodbye {
    width: 100%;
    height: 100%;
    position: relative;
    box-sizing: border-box;
  }
  .loading-info {
    position: absolute;
    height: 50px;
    font-size: 40px;
    font-weight: 600;
    bottom: 0;
    text-shadow: 3px 3px #40404080;
  }
  .loading-info .marquee-item::after {
    content: "／";
    display: inline-block;
    padding: 0 10px;
  }
  .scene-background {
    height: 100%;
    background: var(--scene-background);
    background-size: cover;
  }
  .scene-frame,
  .scene-background-fore,
  .scene-foreground {
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
  }
  .scene-foreground {
    background: var(--scene-foreground, transparent);
    background-size: cover;
  }
  .scene-background-fore {
    background: var(--scene-background-fore, transparent);
    background-size: cover;
  }
</style>
